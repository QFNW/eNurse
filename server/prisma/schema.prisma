generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ========== 用户与认证 ==========

enum Role {
  PATIENT
  NURSE
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  displayName   String
  nickname      String?
  role          Role      @default(PATIENT)
  isVirtual     Boolean   @default(false)
  isDisabled    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bmRecords           BmRecord[]
  medicationRecords   MedicationRecord[]
  medications         Medication[]
  bmReminderSetting   BmReminderSetting?
  alerts              Alert[]
  groupMemberships    GroupMember[]
  createdGroups       Group[]              @relation("GroupCreator")
  adminRequests       AdminRequest[]
  feedbacks           Feedback[]

  @@map("users")
}

// ========== 小组 ==========

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Group {
  id          String    @id @default(cuid())
  name        String
  inviteCode  String    @unique
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator     User      @relation("GroupCreator", fields: [createdBy], references: [id])
  members     GroupMember[]
  adminRequests AdminRequest[]

  @@index([inviteCode])
  @@map("groups")
}

model GroupMember {
  id          String           @id @default(cuid())
  groupId     String
  userId      String
  roleInGroup GroupMemberRole  @default(MEMBER)
  joinedAt    DateTime         @default(now())

  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model AdminRequest {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("admin_requests")
}

// ========== 反馈 ==========

model Feedback {
  id        String   @id @default(cuid())
  // Nullable so feedback survives account deletion (shown as "已注销用户")
  userId    String?
  content   String
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("feedbacks")
}

// ========== 大便系统 ==========

model BmRecord {
  id          String    @id @default(cuid())
  userId      String
  recordedAt  DateTime
  notes       String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("bm_records")
}

model BmReminderSetting {
  id            String   @id @default(cuid())
  userId        String   @unique
  intervalDays  Int      @default(1)
  reminderTime  String   @default("08:00")
  isEnabled     Boolean  @default(true)
  isLocked      Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bm_reminder_settings")
}

// ========== 用药系统 ==========

enum ScheduleType {
  INTERVAL
  FIXED_TIME
}

model Medication {
  id          String    @id @default(cuid())
  userId      String
  name        String
  dosage      String?
  unit        String?
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules   MedicationSchedule[]
  records     MedicationRecord[]

  @@index([userId])
  @@map("medications")
}

model MedicationSchedule {
  id            String        @id @default(cuid())
  medicationId  String
  scheduleType  ScheduleType
  intervalHours Float?
  fixedTimes    Json?
  startTime     DateTime?
  isEnabled     Boolean       @default(true)
  isLocked      Boolean       @default(false)
  updatedAt     DateTime      @updatedAt

  medication    Medication    @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@map("medication_schedules")
}

model MedicationRecord {
  id            String     @id @default(cuid())
  medicationId  String
  userId        String
  takenAt       DateTime
  notes         String?
  createdAt     DateTime   @default(now())

  medication    Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
  @@map("medication_records")
}

// ========== 警报系统 ==========

enum AlertType {
  BM_REMINDER
  MEDICATION_REMINDER
}

model Alert {
  id          String      @id @default(cuid())
  userId      String
  type        AlertType
  // 事项维度：药品 = medicationId，大便 = null（每用户仅一个 BM 事项）。
  // 同一事项的多次提醒只保留最新一条（旧的被自动解决）。
  relatedId   String?
  message     String
  isResolved  Boolean     @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isResolved, createdAt])
  @@index([userId, type, relatedId, isResolved])
  @@map("alerts")
}
