# ========== eNurse production environment ==========
# Copy to .env.prod and fill in real values:
#   cp deploy/.env.prod.example deploy/.env.prod
# NODE_ENV=production forces JWT secrets + ADMIN_PASSWORD_HASH to be required
NODE_ENV=production

# ---- PostgreSQL (used by both compose interpolation and the server container) ----
POSTGRES_USER=enurse
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=enurse
# Inside the compose network, host is "postgres" (not localhost)
DATABASE_URL=postgresql://enurse:CHANGE_ME_STRONG_PASSWORD@postgres:5432/enurse?schema=public

# ---- Redis (compose network host: "redis") ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- JWT secrets — generate with: openssl rand -hex 32 ----
ACCESS_TOKEN_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=CHANGE_ME
REFRESH_TOKEN_EXPIRES_IN=7d

# ---- SMTP (163 mail; SMTP_PASS is the authorization code, not login password) ----
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=l1ghtocean@163.com
SMTP_PASS=CHANGE_ME_SMTP_AUTH_CODE

# ---- Admin login: bcrypt hash of the admin password ----
# Generate with:
#   node -e "const b=require('bcrypt');b.hash('YOUR_ADMIN_PASSWORD',12).then(h=>console.log(h))"
# (plaintext ADMIN_PASSWORD fallback is refused when NODE_ENV=production)
ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH

# ---- Server ----
PORT=3000
# Web admin origin (same domain as nginx). Change if you use a different domain.
CORS_ORIGIN=https://bohack26.kdns.fr
TZ=Asia/Shanghai

# ---- WeChat bot (not yet implemented — placeholder) ----
PADLOCAL_TOKEN=
